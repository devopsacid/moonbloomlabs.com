# Copy to .env (git-ignored) or set in the build environment. Both are optional.
# Cloudflare Turnstile site key (public). Leave empty = no widget, no script.
PUBLIC_TURNSTILE_SITEKEY=
# Cloudflare Web Analytics beacon token (public). Leave empty = no beacon.
PUBLIC_CF_ANALYTICS_TOKEN=
# Set to 1 to build locales whose copy is not marked ready yet (cs, de, es) for review.
PUBLIC_ENABLE_ALL_LOCALES=
