# Moonbloom Labs - Apache 2.4. TLS terminates at openresty in front of Apache,
# so %{HTTPS} is always "off" here: NEVER use it (redirect loop). Use X-Forwarded-Proto.

DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# Redirects: HTTPS and www -> apex
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Only when the proxy explicitly says the client used plain http.
    # Header absent or "https" -> rule does not fire (safe, no loop).
    RewriteCond %{HTTP:X-Forwarded-Proto} =http
    RewriteRule ^ https://moonbloomlabs.com%{REQUEST_URI} [R=301,L]

    RewriteCond %{HTTP_HOST} ^www\.moonbloomlabs\.com$ [NC]
    RewriteRule ^ https://moonbloomlabs.com%{REQUEST_URI} [R=301,L]

    # No Accept-Language based language redirect on purpose: / is served as-is,
    # the site links to /sk/ explicitly.
</IfModule>

# ---------------------------------------------------------------------------
# Dotfiles: deny, except /.well-known/
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_URI} !^/\.well-known/ [NC]
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
</IfModule>

# ---------------------------------------------------------------------------
# Security headers
# FRONTEND REQUIREMENT: the CSP has no 'unsafe-inline' for scripts. Every script
# must be an external bundled file (Astro: no inline <script>; check dist/*.html
# for "<script>" without src). Inline styles are allowed.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
    Header always set X-Frame-Options "DENY"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; form-action 'self' mailto:; base-uri 'self'; object-src 'none'"
</IfModule>

# ---------------------------------------------------------------------------
# MIME types
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType font/woff2 .woff2
    AddType image/avif .avif
    AddType image/webp .webp
    AddType image/svg+xml .svg
    AddDefaultCharset UTF-8
</IfModule>

# ---------------------------------------------------------------------------
# Compression
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE application/manifest+json application/rss+xml application/atom+xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# Caching
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    # HTML must always revalidate so deploys show up immediately.
    <FilesMatch "\.(html|xml|txt|webmanifest)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>

    # Static media: 30 days.
    <FilesMatch "\.(woff2|svg|png|webp|avif|jpg|jpeg|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # Hashed Astro assets: 1 year, immutable (must come last to win over the rules above).
    <If "%{REQUEST_URI} =~ m#^/_astro/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>

    # Contact endpoint: never cache.
    <Files "contact.php">
        Header set Cache-Control "no-store"
    </Files>
</IfModule>
