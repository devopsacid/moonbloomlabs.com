---
import Base from '../layouts/Base.astro';
import Horizon from '../components/art/Horizon.astro';
import AboutArt from '../components/art/AboutArt.astro';
import { getDictionary, rich } from '../i18n';
import { webPage } from '../lib/schema-org';
import { SITE_URL } from '../config/site';
import { pagePath, type Locale } from '../i18n/routes';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = getDictionary(locale);
const a = d.about;
const url = `${SITE_URL}${pagePath(locale, 'about')}`;
---

<Base
  locale={locale}
  pageRef={{ kind: 'page', key: 'about' }}
  title={a.seo.title}
  description={a.seo.description}
  ogTitle={a.og.title}
  ogDescription={a.og.description}
  jsonld={[webPage('AboutPage', a.h1, url, locale)]}
>
  <section class="intro surface-night">
    <div class="container intro__grid intro__grid--art">
      <div>
        <h1>{a.h1}</h1>
        <p class="lead">{a.intro}</p>
      </div>
      <figure class="portrait" style="margin: 0">
        <div class="portrait__frame">
          <AboutArt />
        </div>
        <figcaption>
          <strong>{a.founder.name}</strong>, {a.founder.role}.
          <span set:html={rich(a.founder.photo, locale)} />
        </figcaption>
      </figure>
    </div>
  </section>
  <Horizon from="950" thin />
  <section
    class="section surface-dawn"
    aria-labelledby="founder-title"
    style="padding-top: var(--space-7)"
  >
    <div class="container">
      <div class="reading">
        <h2 id="founder-title">{a.founder.title}</h2>
        <div class="stack" style="margin-top: var(--space-5)">
          {a.founder.body.map((p) => (
            <p>{p}</p>
          ))}
        </div>
      </div>
    </div>
  </section>
  <section class="section surface-dawn-alt" aria-labelledby="principles-title">
    <div class="container">
      <div class="section-head">
        <h2 id="principles-title">{a.principles.title}</h2>
      </div>
      <ul class="pillars pillars--2" role="list">
        {a.principles.items.map((p) => (
          <li class="pillar">
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <section class="section surface-sunrise cta-band" aria-labelledby="cta-title">
    <div class="container">
      <h2 id="cta-title">{a.cta.title}</h2>
      <div class="btn-row" style="margin-top: var(--space-6)">
        <a class="btn" href={`${pagePath(locale, 'contact')}#form`}>
          {a.cta.button}
        </a>
      </div>
    </div>
  </section>
</Base>
