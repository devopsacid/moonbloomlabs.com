---
// Moonflower. state: open | half | closed | seed. animate=true opens it on scroll (CSS only).
interface Props {
  state?: 'open' | 'half' | 'closed' | 'seed';
  animate?: boolean;
  stem?: boolean;
  stroke?: number;
  class?: string;
}
const {
  state = 'open',
  animate = false,
  stem = true,
  stroke = 1.5,
  class: className,
} = Astro.props;
const outer = [0, 1, 2, 3, 4];
---

{state === 'seed' ? (
  <svg
    class={className}
    viewBox="0 0 32 32"
    width="32"
    height="32"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="M16 28c-1-3 0-6 0-9"
      fill="none"
      stroke="var(--color-leaf-500)"
      stroke-width="1.6"
      stroke-linecap="round"
    />
    <path
      d="M16 20c-1-4-4-5-7-5 0 3 2 5 7 5zM16 20c1-3 3-4.5 6-4.5 0 2.5-2 4.5-6 4.5z"
      fill="var(--color-leaf-500)"
    />
    <ellipse cx="16" cy="27.5" rx="4.5" ry="2.2" fill="var(--color-apricot-300)" />
  </svg>
) : (
  <svg
    class:list={['bloom', className]}
    viewBox="0 0 200 200"
    width="200"
    height="200"
    aria-hidden="true"
    focusable="false"
    data-state={animate ? undefined : state}
    data-animate={animate ? '' : undefined}
  >
    {stem && (
      <g class="bloom__stem">
        <path
          d="M100 104C100 140 94 168 100 198"
          fill="none"
          stroke="var(--color-leaf-500)"
          stroke-width="4"
          stroke-linecap="round"
        />
        <path d="M98 160C80 160 66 150 62 136 80 136 94 146 98 160Z" fill="var(--color-leaf-500)" />
        <path
          d="M99 176C116 176 130 168 135 154 117 153 103 162 99 176Z"
          fill="var(--color-leaf-500)"
        />
      </g>
    )}
    <g class="bloom__head">
      <g class="petals petals--outer">
        {outer.map((i) => (
          <g class="petal" style={`--a:${i * 72}deg;--i:${i}`}>
            <path
              d="M100 100C86 78 88 40 100 22C112 40 114 78 100 100Z"
              fill="var(--color-petal-100)"
              stroke="var(--color-bloom-700)"
              stroke-opacity="0.6"
              stroke-width={stroke}
              stroke-linejoin="round"
            />
            <path
              d="M100 96V36"
              stroke="var(--color-petal-300)"
              stroke-width={stroke}
              stroke-linecap="round"
              fill="none"
            />
          </g>
        ))}
      </g>
      <g class="petals petals--inner">
        {outer.map((i) => (
          <g class="petal" style={`--a:${36 + i * 72}deg;--i:${i}`}>
            <path
              d="M100 100C91 84 92 62 100 48C108 62 109 84 100 100Z"
              fill="var(--color-petal-300)"
              stroke="var(--color-bloom-700)"
              stroke-opacity="0.6"
              stroke-width={stroke}
              stroke-linejoin="round"
            />
          </g>
        ))}
      </g>
      <g class="bloom__heart">
        <circle cx="100" cy="100" r="9" fill="var(--color-apricot-300)" />
        {[0, 1, 2, 3, 4].map((i) => (
          <circle
            cx={100 + 15 * Math.sin((i * 72 * Math.PI) / 180)}
            cy={100 - 15 * Math.cos((i * 72 * Math.PI) / 180)}
            r="2"
            fill="var(--color-bloom-700)"
          />
        ))}
      </g>
    </g>
  </svg>
)}
