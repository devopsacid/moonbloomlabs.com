  chatbots_ai_assistants:
    'M3 5.500C3 4.700 3.700 4 4.500 4h8c.8 0 1.500.7 1.500 1.500v4c0 .8-.7 1.500-1.500 1.500H8l-3 2.500V11H4.500C3.700 11 3 10.300 3 9.500zM16.500 9h3c.8 0 1.500.7 1.500 1.500v5c0 .8-.7 1.500-1.500 1.500H19v3l-3.500-3H11M6.500 7.500c1.500 0 2.500-.8 3-2',
  gamification:
    'M12 21V9M7 21h10M12 17.500c-3 0-5-1.500-5-4 3 0 5 1.500 5 4zM12 14c3 0 5-1.500 5-4-3 0-5 1.500-5 4zM12 9C10 7.500 10 4.500 12 3c2 1.500 2 4.500 0 6z',
  ai_integration:
    'M3 20.500L13 10.500M10.500 14.500l3 3M12 13l3 3M13.500 11.500l3 3M13 14.500c0-4 3-6.500 6-7.500M19 7c.5-2 2-3 3-3.200 0 1.500-.8 3-3 3.200z',
  devops_cloud:
    'M5 3v18M19 3v18M5 8h14M5 14h14M5 20c3 0 4-3 7-3s3-3 6-3M9 11.500c1-1.500 2.500-1.500 3-.5M14 17c1-.8 2.500-.6 3 .5',
  chevron: 'M9 5l7 7-7 7',
  warning: 'M12 3.500L22 20H2zM12 10v5M12 17.500v.5',
  check: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM8 12.500l3 3 5-6',
};
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  width={size ?? 24}
  height={size ?? 24}
  aria-hidden="true"
  focusable="false"
>
  <path d={paths[name]}></path>
</svg>
